# Rewind Backend Environment Configuration
# Copy this file to .env and fill in your keys:
# cp .env.example .env

# HuggingFace Access Token (optional, required for Embeat audio features & genre)
# 1. Sign up at https://huggingface.co
# 2. Accept dataset conditions at https://huggingface.co/datasets/GD-Studio/embeat_45m_spotify_tracks
# 3. Create a User Access Token starting with hf_ at https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here
